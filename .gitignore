frontend/dist
coverage
frontend/coverage-ui/lcov-report
node_modules

# Encrypted server-side token vault (contains LLM tokens). Never commit.
.vault/

# Plaintext per-user LLM *selection* store (provider/baseUrl/model + agency
# overrides) — runtime state, survives restart, NOT a secret but never commit.
.data/
llm-config.db
llm-config.db-shm
llm-config.db-wal

# Generated reports (CEO/CFO export artifacts; per-day dirs under reports/).
reports/
frontend/coverage-ui/
logs/
tmp/

# TypeScript incremental build info
tsconfig.tsbuildinfo
*.tsbuildinfo

# Graphify code knowledge-graph output (run `npm run graphify` to (re)generate).
# Graphify's own docs say graph.json + GRAPH_REPORT.md are meant to be committed
# so teammates skip re-indexing; the cache/ and graph.html visualizer are
# regenerable. Ignore the dir's *contents* (not the dir entry) so the two
# shareable artifacts below can be re-included.
.graphify/**
!.graphify/graph.json
!.graphify/GRAPH_REPORT.md
graphify-out/
