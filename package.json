{
  "name": "tradingcorp",
  "version": "1.0.0",
  "description": "Multi-agent financial analysis system (TradingCorp) with preservation-first philosophy",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:all": "concurrently -n server,web -c blue,green \"LLM_VAULT_PASSPHRASE=my_secret PORT=${PORT:-3001} npm run server\" \"VITE_SERVER_PORT=${PORT:-3001} npm run dev\"",
    "build": "npm rebuild better-sqlite3 && npx vite build --config vite.config.ts",
    "start": "npm run build && npm run server",
    "server": "tsx src/server/index.ts",
    "server:watch": "tsx watch src/server/index.ts",
    "test": "npm rebuild better-sqlite3 && npm run test:server && npm run test:ui",
    "test:server": "npm rebuild better-sqlite3 && jest --coverage",
    "test:cov": "npm rebuild better-sqlite3 && jest --coverage",
    "test:ui": "vitest run --coverage --config vite.config.ts",
    "test:ui:watch": "vitest --coverage --config vite.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "test:watch": "jest --watch",
    "graphify": "GRAPHIFY_OUT=.graphify graphify extract . --code-only && GRAPHIFY_OUT=.graphify graphify cluster-only .",
    "graphify:docs": "GRAPHIFY_OUT=.graphify graphify extract ."
  },
  "keywords": [
    "financial",
    "analysis",
    "multi-agent",
    "langgraph",
    "preservation",
    "react",
    "vite",
    "socket.io",
    "d3"
  ],
  "author": "Hermes Agent",
  "license": "MIT",
  "dependencies": {
    "@fontsource/playfair-display": "^5.2.8",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.38",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "better-sqlite3": "^12.11.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "pdfkit": "^0.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.1",
    "tsx": "^4.23.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
